private void test_bonus_edge () {
	test("%.3s", (string?)null);
	test("%.5s", (string?)null);
	test("%.6s", (string?)null);
	test("%.7s", (string?)null);
	test("%-10s|", (string?)null);
	test("%10.3s|", (string?)null);
	test("%-10.6s|", (string?)null);
	test("%5c", 0);
	test("%-5c|", 0);
	test("%1c%-1c%2c", 0, 0, 0);
	test("%20p", null);
	test("%-20p|", null);
	test("%5p", null);
	test("%-25p|", (void*)ulong.MAX);
	test("%25p", (void*)long.MIN);
	test("%#5.0x|", 0);
	test("%#-8x|", 255);
	test("%#08x", 255);
	test("%#.8X", 255);
	test("%+d", 0);
	test("% +d", 42);
	test("%+ d", 42);
	test("% +d", -42);
	test("%+05d", 42);
	test("% 05d", 42);
	test("%+-6d|", 42);
	test("% -6d|", 42);
	test("%+d", int.MIN);
	test("% d", int.MIN);
	test("%+d", int.MAX);
	test("% .0d|", 0);
	test("%05d", -42);
	test("%-05d|", 42);
	test("%0-5d|", -42);
	test("%08.3d", 42);
	test("%08.3d", -42);
	test("%08.0d", 0);
	test("%010.5x", 255);
	test("%5.0d|", 0);
	test("%-5.0d|", 0);
	test("%.10d", int.MIN);
	test("%.10i", -1);
	test("%.12u", uint.MAX);
	test("%.12x", -1);
	test("%0100d", 42);
	test("%-100d|", 42);
	test("%100s", "hello");
	test("%.100s", "hello");
	test("%.0s|", "hello");
	test("%.s|", "hello");
	test("%-10.2s|", "hello");
	test("%10.2s", "hello");
	test("%3s", "hello");
	test("%-3s|", "hello");
	test("%5s", "");
	test("%-5s|", "");
	test("%----5d|", 1);
	test("%00005d", 1);
	test("%-0-0-5d|", 1);
	test("%++++d", 1);
	test("%    d", 1);
	test("%####x", 1);
	test("%-5c%-5s%-5d%-5u%-5x%-5X|", 'a', "b", 1, 2, 3, 4);
	test("%5c%5s%5d%5u%5x%5X%20p", 'a', "b", 1, 2, 3, 4, null);
	test("%-+8.3d|% 08.3i|%#-8.3x|%#08.3X|", 42, -42, 42, 42);
}

async void run_bonus_tests () {
	yield describe("Bonus: Width");
	test_bonus_width();
	yield describe("Bonus: -");
	test_bonus_minus();
	yield describe("Bonus: 0");
	test_bonus_zero();
	yield describe("Bonus: .");
	test_bonus_dot();
	yield describe("Bonus: #");
	test_bonus_sharp();
	yield describe("Bonus: +");
	test_bonus_plus();
	yield describe("Bonus: space");
	test_bonus_space();
	yield describe("Bonus: Mix");
	test_bonus_mix();
	yield describe("Bonus: Edge cases");
	test_bonus_edge();
}
