private void test_bonus_width () {
	test("{%10d}", 42);
	test("{%4d}", 10000);
	test("{%30d}", 10000);
	test("{%10d}", -42);
	test("{%3c}", 0);
	test("%23s", (string?)null);
	test("%32s", "abc");
	test("%16s", "nark nark");
	test("%5s", "goes over");
	test("%3s%3s", "hello", "world");
	test("%32s", (string?)null);
	test("%2s", (string?)null);
	test("%7i", 33);
	test("%7i", -14);
	test("%3i", 0);
	test("%5i", 52625);
	test("%5i", -2562);
	test("%4i", 94827);
	test("%4i", -2464);
	test("%7d", 33);
	test("%7d", -14);
	test("%3d", 0);
	test("%5d", 52625);
	test("%5d", -2562);
	test("%4d", 94827);
	test("%4d", -2464);
	test("%7u", 33);
	test("%3u", 0);
	test("%5u", 52625);
	test("%4u", 94827);
	test("%7x", 33);
	test("%3x", 0);
	test("%5x", 52625);
	test("%2x", 94827);
	test("%7X", 33);
	test("%3X", 0);
	test("%5X", 52625);
	test("%2X", 94827);
	test("%5c", '\0');
	test("%10x\n", 20);
	test("%15p\n", null);
	test("%10c", 't');
	test("%1c", 'y');
	test("%10s", (string?)null);
	test("%10s", "Ok");
	test("t14 %10d\n", 1000);
	test("taaa %100s\n", "hello");
	test("%1s", "Hallo heimur");
	test("%1d", 1024);
	test("%1d", -1024);
	test("%1i", 1024);
	test("%1i", -1024);
	test("%1u", 1024U);
	test("%1u", -1024U);
	test("%1x", 0x1234abcdu);
	test("%1x", -0x1234abcdu);
	test("%1X", 0x1234abcdu);
	test("%1X", -0x1234abcdu);
	test("%1c", 'x');
	test("%20s", "Hallo");
	test("%20d", 1024);
	test("%20d", -1024);
	test("%20i", 1024);
	test("%20i", -1024);
	test("%20u", 1024U);
	test("%20u", -1024U);
	test("%20x", 0x1234abcdu);
	test("%20x", -0x1234abcdu);
	test("%20X", 0x1234abcdu);
	test("%20X", -0x1234abcdu);
	test("%20c", 'x');
	test("%5d", 2);
	test("%1d", 2);
	test("%256d", 244);
	test("%5d", 22222222);
	test("%5s", "hi");
	test("%5s", "haiiii!!! UwU");
	test("%3c", 0);
}

